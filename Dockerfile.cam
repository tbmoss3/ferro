FROM condaforge/linux-64:latest
LABEL io.railway.custom=("Ferro CAM sidecar")
WORKDIR /app
COPY cam_service.py cam_bridge.py gcode_verify.py ./
RUN conda install -y -c conda-forge freecad fastapi uvicorn python-fastjsonschema \
    || micromamba install -y -c conda-forge freecad fastapi uvicorn
ENV PORT=8812
EXPOSE 8812
CMD ["sh", "-c", "uvicorn cam_service:app --host 0.0.0.0 --port ${PORT:-8812}"]